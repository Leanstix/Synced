{
  "name": "synced",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "index.ts",
  "description": "Intentional local phone sharing and control, built with React Native and TypeScript.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leanstix/Synced.git"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check:source": "node scripts/check-source.mts",
    "check": "npm run check:source && npm run typecheck && npm run lint && npm test",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "bundle:android": "expo export --platform android",
    "postinstall": "node scripts/prepare-dependencies.mts"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@livekit/react-native": "3.1.0",
    "@livekit/react-native-expo-plugin": "1.1.0",
    "@livekit/react-native-webrtc": "150.1.1",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "buffer": "^6.0.3",
    "expo": "~58.0.20",
    "expo-build-properties": "~58.0.11",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-intent-launcher": "~58.0.3",
    "expo-network": "~58.0.4",
    "expo-status-bar": "~58.0.4",
    "livekit-client": "2.23.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-accessibility-controller": "git+https://github.com/bedda-tech/react-native-accessibility-controller.git#133fdaf0a61044e1c899681391b79f1845c9c2ee",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-tcp-socket": "^6.3.0"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.50.0",
    "@types/node": "^24",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
